<?xml version="1.0" encoding="utf-8"?>
<!-- Toque longo no ícone "grana" -> tela do coletor (que não tem ícone próprio). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="coletor"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_coletor">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="dev.grana.coletor"
            android:targetClass="dev.grana.coletor.MainActivity" />
    </shortcut>
</shortcuts>
